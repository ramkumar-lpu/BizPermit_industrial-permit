# ==============================================================================
# BIZPERMIT ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env before starting Docker Compose:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE DJANGO CONFIGURATION
# ------------------------------------------------------------------------------
# In development: True. In production: MUST be False.
DEBUG=True

# Django secret key for session/CSRF signing. Generate a strong key for production.
SECRET_KEY=django-insecure-dev-fallback-key-2026

# Comma-separated list of hostnames/IPs this backend service serves.
ALLOWED_HOSTS=localhost,127.0.0.1,backend,frontend

# Comma-separated list of allowed frontend origins for CORS.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:80,http://127.0.0.1:80,http://localhost

# ------------------------------------------------------------------------------
# 2. MONGODB DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Local Docker Compose service URL:
MONGODB_URI=mongodb://mongo:27017/bizpermit_db

# For external MongoDB Atlas (uncomment and replace placeholders):
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/bizpermit_db?retryWrites=true&w=majority

MONGODB_DB_NAME=bizpermit_db

# Set to False in Docker to ensure database failures are raised rather than silently falling back to mock memory.
USE_MOCK_DB_IF_UNAVAILABLE=False

# Control automatic initial baseline demo seeding when database is empty.
# In development: True (auto-populates demo accounts on first boot).
# In production: False (prevents demo records in production).
AUTO_SEED_DEMO_DATA=True

# ------------------------------------------------------------------------------
# 3. JWT AUTHENTICATION
# ------------------------------------------------------------------------------
# Cryptographic secret for signing JWT access and refresh tokens.
JWT_SECRET_KEY=bizpermit-default-jwt-secret-phase1-2026

# Token expiration lifetimes
JWT_ACCESS_EXPIRY_MINUTES=15
JWT_REFRESH_EXPIRY_DAYS=7

# ------------------------------------------------------------------------------
# 4. EMAIL & NOTIFICATION SETTINGS
# ------------------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@bizpermit.local
FRONTEND_BASE_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 5. SUPABASE CLOUD STORAGE (OPTIONAL FOR LOCAL DEV, REQUIRED FOR CLOUD VAULT)
# ------------------------------------------------------------------------------
# Leave empty for local offline mock storage fallback, or provide real keys for cloud uploads:
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_BUCKET_NAME=bizpermit

# ------------------------------------------------------------------------------
# 6. FRONTEND API NETWORKING
# ------------------------------------------------------------------------------
# Used by frontend client (defaults to relative /api/v1 for Vite and Nginx reverse proxying)
VITE_API_BASE_URL=/api/v1

# Target URL used by Vite dev server inside Docker to proxy /api requests to backend:
BACKEND_PROXY_URL=http://backend:8000

# ------------------------------------------------------------------------------
# 7. PRODUCTION DOCKER EXPOSED PORT
# ------------------------------------------------------------------------------
# Port mapped on the host machine in production Compose mode (default: 8085):
PROD_PORT=8085
